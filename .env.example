# Optional bootstrap settings. The app stores inverter config in the database.
# Copy this file to .env only if you need to override defaults.

# Directory for SQLite and other runtime files (default: ./data)
# DATA_DIR=./data

# Override the database URL. Defaults to SQLite at $DATA_DIR/gridmonitor.db
# DATABASE_URL=sqlite+aiosqlite:///./data/gridmonitor.db
# DATABASE_URL=postgresql+asyncpg://gridmonitor:gridmonitor@db:5432/gridmonitor

# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=8000
# TZ=UTC

# Contact sent to browser push services with every notification (URL or mailto:).
# VAPID_SUBJECT=mailto:you@example.com
